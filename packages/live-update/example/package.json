{
  "name": "capacitor-app",
  "version": "1.0.0",
  "description": "An Amazing Capacitor App",
  "main": "index.js",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e2e:android": "adb reverse tcp:4000 tcp:4000 && concurrently -k -s first \"node test/mock-server.mjs\" \"node test/run-maestro-flows.mjs\"",
    "e2e:ios": "concurrently -k -s first \"node test/mock-server.mjs\" \"node test/run-maestro-flows.mjs\"",
    "e2e:electron": "npm run build && cap sync @capawesome/capacitor-electron && tsc -p electron/tsconfig.json && node test/electron/support/build-fixtures.mjs && playwright test -c test/electron/playwright.config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capawesome/capacitor-live-update": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capawesome/capacitor-electron": "^0.2.0",
    "@capawesome/cli": "^4.18.2",
    "@playwright/test": "1.63.0",
    "concurrently": "^9.0.0",
    "electron": "^44.0.0",
    "typescript": "^5.5.0",
    "vite": "7.2.2"
  }
}
